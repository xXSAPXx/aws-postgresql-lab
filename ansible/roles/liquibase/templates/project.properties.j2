# Managed by Ansible (role: liquibase). Liquibase settings for the {{ liquibase_project.name }} database.
# Use it through the wrapper command: liquibase-{{ liquibase_project.name }} <command>
changelog-file: changelog.yaml
search-path: {{ liquibase_projects_dir }}/{{ liquibase_project.name }}
url: {{ liquibase_project.url }}
username: {{ liquibase_project.username }}
password: {{ liquibase_project.password }}
# Where Liquibase keeps DATABASECHANGELOG / DATABASECHANGELOGLOCK. Pinned, because otherwise Liquibase uses the
# first schema of the session's search_path, and a migration that changes search_path would make it lose its history.
liquibase-schema-name: {{ liquibase_project.liquibase_schema | default('public') }}
{% for name, value in (liquibase_project.parameters | default({})).items() %}
parameter.{{ name }}: {{ value }}
{% endfor %}
