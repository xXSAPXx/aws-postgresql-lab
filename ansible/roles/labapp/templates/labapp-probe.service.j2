# Managed by Ansible (role: labapp).
[Unit]
Description=labapp probe: database availability and latency, measured from the application's side
Wants=network-online.target
After=network-online.target docker.service

[Service]
User={{ labapp_user }}
Group={{ labapp_user }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ labapp_dir }}/venv/bin/python {{ labapp_dir }}/labapp.py probe --config /etc/labapp/probe.json
Restart=always
RestartSec=2
# Outage log: /var/log/labapp/outages.jsonl (read it with: labapp outages)
LogsDirectory=labapp
LogsDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
