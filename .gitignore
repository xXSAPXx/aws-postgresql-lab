
##################### Terraform Ignore ######################
# Patterns apply to every lab (labs/<lab>/terraform/) and module.

# Ignore tfvars.file (terraform.tfvars.example stays tracked)
*.tfvars

# Ignore Terraform working directory
.terraform/

# Ignore Terraform state files
*.tfstate
*.tfstate.backup

# Ignore crash logs, plan and lock files
crash.log
tfplan
.terraform.lock.hcl



