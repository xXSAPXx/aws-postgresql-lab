
# Copy this file to terraform.tfvars (ignored by .gitignore) in this directory and fill in your values:
# TF_VARS:

# Key pair for the EC2 instances
aws_key_pair               = "<EXAMPLE>"

# Your public IP with /32 (get it with: curl -s https://checkip.amazonaws.com). Only this IP can reach SSH and the PMM UI.
admin_cidr                 = "203.0.113.10/32"

# Optional: private key of that key pair, used in the generated SSH config (~/.ssh/aws-postgresql-lab.conf).
# ssh_private_key_path     = "~/.ssh/<key>"
