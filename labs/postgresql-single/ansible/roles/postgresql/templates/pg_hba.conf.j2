# Managed by Ansible (role: postgresql). Re-running the playbook overwrites manual changes.
# TYPE  DATABASE        USER            ADDRESS                 METHOD

# Unix socket: OS user = database user (e.g. sudo -u postgres psql).
local   all             all                                     peer

# Localhost TCP: passwords (pmm-agent connects here as the pmm user).
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256

local   replication     all                                     peer
host    replication     all             127.0.0.1/32            scram-sha-256
host    replication     all             ::1/128                 scram-sha-256

# Network: each user only to its own database, only from its own source.
{% for rule in postgresql_hba_rules %}
{{ '%-7s %-15s %-15s %-23s %s' | format('host', rule.database, rule.user, rule.address, rule.method | default('scram-sha-256')) }}
{% endfor %}

# Anything else has no matching line and is rejected.
